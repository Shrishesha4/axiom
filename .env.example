OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_MODEL=openai/gpt-4o
# Enable OpenRouter web search plugin (extra API cost per request)
OPENROUTER_WEB_SEARCH_ENABLED=false
OPENROUTER_WEB_SEARCH_MAX_RESULTS=5
# Optional: native|exa|parallel|perplexity|firecrawl
# OPENROUTER_WEB_SEARCH_ENGINE=
# Optional engine mode (e.g. exa: auto|fast|deep, parallel: turbo|basic)
# OPENROUTER_WEB_SEARCH_MODE=
# Optional native search context: low|medium|high
# OPENROUTER_WEB_SEARCH_CONTEXT_SIZE=
OPENFDA_API_KEY=

POSTGRES_USER=axiom
POSTGRES_PASSWORD=axiom
POSTGRES_DB=axiom_db
DATABASE_URL=postgresql://axiom:axiom@db:5432/axiom_db

JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@axiom.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Admin
DEFAULT_USER_TOKEN_LIMIT=100000

NEXT_PUBLIC_API_URL=http://localhost:8000
